# Copy to .env.local and fill in. Without these, the app runs on mock data.
# NEVER commit real values. .env.local is gitignored — only this example is tracked.

# ----------------------------------------------------------------------------
# Supabase (required for auth, data, storage, realtime)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server-only — bypasses RLS, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Site URL (used by sitemap, robots, OG, canonical, push notification links)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://siyoh-web.vercel.app

# ----------------------------------------------------------------------------
# Search engine verification (paste tokens after registering domains)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ----------------------------------------------------------------------------
# Firebase Cloud Messaging (optional — push notifications)
# Get these from Firebase Console → Project settings → General → Your apps
# All NEXT_PUBLIC_* values are safe to expose. They identify the project but
# don't authorize writes. The dangerous secret (service account JSON) lives
# only in the Supabase edge function env, never in the client bundle.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# VAPID key — Firebase console → Project settings → Cloud Messaging →
# Web configuration → "Generate key pair".
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
