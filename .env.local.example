# Copy to .env.local and fill in. Without these, the app runs on mock data.
# NEVER commit real values. .env.local is gitignored — only this example is tracked.

# Required (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, server-only — bypasses RLS, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
